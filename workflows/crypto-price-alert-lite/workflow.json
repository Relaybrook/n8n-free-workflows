      "id": "d3338864-756c-5e29-bc56-ff43c8048f0c",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turns the watchlist text into rules: [{coin, dir: 'above'|'below', level}]\nconst cfg = $('Config').first().json;\nconst rules = [], problems = [];\nfor (const raw of String(cfg.watchlist || '').split(/\\r?\\n/)) {\n  const line = raw.trim();\n  if (!line || line.startsWith('#')) continue;\n  const m = line.match(/^([a-z0-9-]+)\\s*:\\s*(.+)$/i);\n  if (!m) { problems.push('Could not read line: ' + line); continue; }\n  const coin = m[1].toLowerCase();\n  for (const part of m[2].split(',')) {\n    const r = part.trim().match(/^(above|below)\\s+\\$?([0-9][0-9.,_]*)$/i);\n    if (!r) { problems.push('Could not read rule \"' + part.trim() + '\" for ' + coin); continue; }\n    const level = Number(r[2].replace(/[,_]/g, ''));\n    if (!isFinite(level) || level <= 0) { problems.push('Bad number in \"' + part.trim() + '\"'); continue; }\n    rules.push({ coin, dir: r[1].toLowerCase(), level });\n  }\n}\nif (!rules.length) throw new Error('No valid rules in watchlist. Example line: \"bitcoin: above 70000, below 60000\". ' + problems.join(' | '));\nconst coins = [...new Set(rules.map(r => r.coin))];\nconst vs = String(cfg.vs_currency || 'usd').toLowerCase();\nconst url = String(cfg.coingecko_base_url || 'https://api.coingecko.com/api/v3').replace(/\\/+$/, '') +\n  '/simple/price?ids=' + encodeURIComponent(coins.join(',')) + '&vs_currencies=' + encodeURIComponent(vs);\nreturn [{ json: { rules, coins, vs, url, problems } }];"
      },
