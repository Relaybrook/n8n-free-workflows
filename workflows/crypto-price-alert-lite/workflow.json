      "id": "797eb199-f5ad-536e-ab8e-938ae3abf29e",
      "name": "Get Prices (CoinGecko)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        240
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Compares prices to the rules. Each rule fires once, then re-arms when the price is back on the other side.\nconst cfg = $('Config').first().json;\nconst p = $('Parse Watchlist').first().json;\nconst res = $input.first().json;\nconst live = !cfg.test_mode;\nconst state = $getWorkflowStaticData('global');\nstate.fired = state.fired || {};\nconst status = Number(res.statusCode || 0);\nlet prices = null, error = null;\nif (status === 429) error = 'CoinGecko rate limit (HTTP 429). Run less often, or try again later.';\nelse if (status && status !== 200) error = 'CoinGecko answered HTTP ' + status + '.';\nelse { const raw = res.body !== undefined ? res.body : res.data;\n  try { prices = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) { error = 'Could not read CoinGecko response.'; }\n  if (!error && (!prices || typeof prices !== 'object')) error = 'Empty response from CoinGecko.'; }\nif (!error && res.error) error = 'Request failed: ' + (res.error.message || res.error);\nconst fmt = n => n >= 1 ? n.toLocaleString('en-US', { maximumFractionDigits: 2 }) : String(Number(n.toPrecision(4)));\nconst alerts = [], unknown = [];\nif (!error) {\n  for (const r of p.rules) {\n    const price = prices && prices[r.coin] ? Number(prices[r.coin][p.vs]) : NaN;\n    if (!isFinite(price)) { if (!unknown.includes(r.coin)) unknown.push(r.coin); continue; }\n    const key = r.coin + '|' + r.dir + '|' + r.level;\n    const hit = r.dir === 'above' ? price > r.level : price < r.level;\n    if (hit && !(live && state.fired[key])) {\n      alerts.push({ coin: r.coin, dir: r.dir, level: r.level, price, text: r.coin + ' is ' + r.dir + ' ' + fmt(r.level) + ' ' + p.vs.toUpperCase() + ' (now ' + fmt(price) + ')' });\n    }\n    if (live) { if (hit) state.fired[key] = true; else delete state.fired[key]; }\n  }\n}\nconst lines = alerts.map(a => (a.dir === 'above' ? '\\u{1F53A} ' : '\\u{1F53B} ') + a.text);\nconst notes = [...p.problems];\nif (unknown.length) notes.push('No price for: ' + unknown.join(', ') + ' (check the CoinGecko id)');\nif (error) notes.push(error);\nconst text = lines.length ? 'Price alert\\n' + lines.join('\\n') + (notes.length ? '\\n\\nNote: ' + notes.join(' | ') : '') + '\\n\\nData by CoinGecko' : '';\nconst fmtName = String(cfg.webhook_format || 'discord').toLowerCase();\nconst webhook_body = fmtName === 'slack' ? { text } : fmtName === 'json' ? { alerts, notes, source: 'CoinGecko' } : { content: text };\nreturn [{ json: { alert_count: alerts.length, alerts, notes, message: text, webhook_body, test_mode: !live, checked_at: new Date().toISOString() } }];"
      },
