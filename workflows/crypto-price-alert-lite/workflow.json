        "jsCode": "// Sample CoinGecko /simple/price response (made-up prices) so test mode needs no network.\n// bitcoin 58,900 (below 60,000 -> alert), ethereum 2,450 (no alert), solana 212 (above 200 -> alert)\nreturn [{ json: { data: JSON.stringify({ bitcoin: { usd: 58900 }, ethereum: { usd: 2450 }, solana: { usd: 212 } }), statusCode: 200, sample: true } }];"
      },
